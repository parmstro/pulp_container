---
# OCP {{ ocp_minor }} container image digest tags
# Generated by generate-ocp-product.yml
# Z-stream releases included: {{ included_versions | join(', ') }}
# Generated: {{ lookup('pipe', 'date -u +%Y-%m-%dT%H:%M:%SZ') }}

ocp_{{ ocp_minor | replace('.', '') }}_release_tags:
{% for tag in merged_release_tags | sort %}
  - "{{ tag }}"
{% endfor %}

ocp_{{ ocp_minor | replace('.', '') }}_art_dev_tags:
{% for tag in merged_art_dev_tags | sort %}
  - "{{ tag }}"
{% endfor %}
